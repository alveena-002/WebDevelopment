# GEMINI_API_KEY: Required for Gemini AI API calls (buyer matching, listing copy, GMB SEO content).
# Get a key from https://aistudio.google.com/app/apikey and set it in your local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_PLACES_API_KEY: Required for live Google data — nearby schools/stations/
# supermarkets per property, and the agency's real Google Business Profile rating.
# Enable the "Places API" and "Geocoding API" in Google Cloud Console, then create
# an API key: https://console.cloud.google.com/google/maps-apis/credentials
# Note: Google requires billing to be enabled on the project (a free monthly
# credit covers typical usage for a demo/small agency).
GOOGLE_PLACES_API_KEY="MY_GOOGLE_PLACES_API_KEY"
