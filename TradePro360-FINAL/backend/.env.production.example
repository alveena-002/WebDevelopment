# TradePro 360 backend — production environment variables.
# Copy to .env (or set these directly in your hosting provider's env
# var UI — see DEPLOYMENT.md) and fill in real values.
#
# Nothing here is required to run the app locally — `npm install && npm
# start` with NO .env file at all still boots on SQLite in demo mode,
# exactly as it always has. Everything below only matters once you're
# deploying somewhere real.

# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
PORT=4000

# REQUIRED in production. Signs and verifies login JWTs — without a real
# secret here every deployment shares the same insecure default
# ('dev-secret-change-in-production') and tokens can be forged.
JWT_SECRET=

# Comma-separated allowlist of origins allowed to call this API, e.g.
# https://app.example.com,https://admin.example.com
# Optional — defaults to "*" (any origin) when unset, which is fine for
# local dev but should be locked down in production.
CORS_ORIGIN=

# Base URL this API is publicly reachable at (used to build absolute
# /uploads/... photo URLs when using the local-disk storage fallback).
# Optional — falls back to the request's own protocol+host when unset.
PUBLIC_URL=

# ---------------------------------------------------------------------
# Database — optional. Unset = SQLite (tradepro360.db, zero setup).
# Set = PostgreSQL + PostGIS; migrations run automatically on boot.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/tradepro360

# ---------------------------------------------------------------------
# Payments — optional. Unset = demo mode (bookings marked paid
# immediately, no real charge).
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Real driving ETA — optional. Unset = haversine-distance estimate
# (works with zero external keys).
# ---------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------
# Photo storage — optional. Unset = local disk under backend/uploads/
# (served at /uploads/*, fine for a single-instance deployment; use S3
# once you're running more than one instance / want durable storage).
# ---------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Only needed for S3-compatible providers other than AWS (MinIO,
# Cloudflare R2, Backblaze B2, etc).
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Override the public URL prefix returned for uploaded photos, e.g. a
# CDN in front of the bucket. Defaults to the bucket's own S3 URL.
AWS_S3_PUBLIC_URL_BASE=
